        {
          "name": "last_updated_timestamp",
          "type": "TIMESTAMP",
          "nullable": false,
          "description": "Last update timestamp"
        },
        {
          "name": "data_quality_score",
          "type": "DECIMAL(3,1)",
          "nullable": true,
          "description": "Data quality score (0-10)"
        }
      ],
      "partitions": [
        "report_date"
      ],
      "primary_key": [
        "report_date"
      ]
    },
    "data_lineage": {
      "upstream_dependencies": [
